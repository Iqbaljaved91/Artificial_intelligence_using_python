    "class Car:\n",
    "    def __init__(self, color):\n",
    "        self.color = color\n",
    "\n",
    "    def start(self):\n",
    "        print(f\"{self.color} car started\")\n",
    "\n",
    "# First object\n",
    "my_car = Car(\"red\")\n",
    "my_car.start()\n",
    "\n",
    "# Second object\n",
    "mybrother_car = Car(\"red\")\n",
    "mybrother_car.start()"
   ]
